# Copie ce fichier en ".env" et remplis les vraies valeurs pour un build local.
# En production (Netlify), ces mêmes clés se configurent dans :
# Site configuration -> Environment variables (ne JAMAIS committer le ".env" réel).

# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Console -> Authentication -> Users -> colonne "User UID" du compte admin
ADMIN_UID=
